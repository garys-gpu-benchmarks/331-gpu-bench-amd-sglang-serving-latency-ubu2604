  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Measure SGLang concurrent serving latency percentiles under load"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates concurrent serving latency percentiles and request throughput. This is not sequential prompt-response. Smoke uses scripts/tiny_sglang_server.py; baseline and extended use sglang.launch_server"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: E2E latency, ms (end_to_end_request_latency_p50_msec); #2: TTFT, ms (ttft_p50_msec); #3: TPOT, ms (time_per_output_token_tpot_p50_msec); #4: ITL, ms (inter_token_latency_itl_p50_msec); #5: Request throughput (request_throughput_requests_sec)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Smoke starts scripts/tiny_sglang_server.py; baseline and extended start python -m sglang.launch_server, then scripts/bench_serving.py"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Launch scripts/tiny_sglang_server.py on smoke, or python -m sglang.launch_server with Mistral-7B-v0.3 on baseline and extended, on port 30000. Then run scripts/bench_serving.py with yaml num_prompts and max_concurrency, to measure concurrent serving latency and throughput. This is not prompt_response_client.py"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "On smoke, start scripts/tiny_sglang_server.py. On baseline and extended, start python -m sglang.launch_server with Mistral-7B-v0.3 on port 30000. Then run scripts/bench_serving.py with yaml num_prompts and max_concurrency, and record end-to-end latency, TTFT, TPOT, ITL, and throughput. This is not prompt_response_client.py"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Same SGLang/tiny_sglang server split as 130 on port 30000. Then runs scripts/bench_serving.py concurrently. num_prompts, max_concurrency, input_len, and output_len come from yaml. Do not use prompt_response_client.py. output_format: csv"
  },
